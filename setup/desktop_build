#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
"$FORMENCODER_ROOT/setup/build_frontend"
"$FORMENCODER_ROOT/setup/freeze_backend"
triple="$(fe_target_triple)" || fe_die "rustc not found; run ./formencoder install-desktop"
fe_venv
python "$FORMENCODER_ROOT/setup/bundle_ffmpeg.py" --target "$triple"
if [ "$(fe_os)" = macos ]; then
  python "$FORMENCODER_ROOT/setup/sign_resources.py"
fi
cd "$FORMENCODER_ROOT"
frontend/node_modules/.bin/tauri build "$@"
fe_say "bundles are in src-tauri/target/release/bundle"
