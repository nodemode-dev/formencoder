#!/usr/bin/env bash
set -e
source "$(dirname "$0")/lib.sh"
fe_venv
command -v cargo >/dev/null 2>&1 || fe_die "Rust is required for the encoding engine: install it from https://rustup.rs (1.95 or newer)"
profile=(--release)
for arg in "$@"; do
  case "$arg" in
    --dev) profile=() ;;
  esac
done
python -c "import maturin" 2>/dev/null || pip install "maturin>=1.15,<2"
cd "$FORMENCODER_ROOT/native/fencoder-py"
maturin develop "${profile[@]}"
python -c "import json, fe_core; c = json.loads(fe_core.Engine().execute('app.capabilities', '{}', 'setup')); print('[formencoder] engine', fe_core.__version__, 'ready:', c['commands'], 'commands,', c['formats'], 'formats,', c['presets'], 'presets')"
