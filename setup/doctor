#!/usr/bin/env bash
source "$(dirname "$0")/lib.sh"
fail=0
ok() { printf '  ok     %s\n' "$1"; }
bad() { printf '  FAIL   %s · %s\n' "$1" "$2"; fail=1; }
warn() { printf '  warn   %s · %s\n' "$1" "$2"; }
fe_say "doctor · $(fe_os)"
if command -v node >/dev/null 2>&1 && node -e 'const [m,n]=process.versions.node.split(".").map(Number);process.exit((m===20&&n>=19)||(m===22&&n>=12)||m>=23?0:1)'; then ok "node $(node -v)"; else bad "node" "Node 20.19+ or 22.12+ is required"; fi
if command -v npm >/dev/null 2>&1; then ok "npm"; else bad "npm" "install npm"; fi
if py="$(fe_python)"; then ok "python $("$py" -V 2>&1 | awk '{print $2}')"; else bad "python" "Python 3.12+ is required"; fi
if command -v cargo >/dev/null 2>&1; then ok "rust $(rustc --version | awk '{print $2}')"; else bad "rust" "the encoding engine needs Rust 1.95+ from https://rustup.rs"; fi
if [ -f "$FORMENCODER_ROOT/backend/venv/bin/activate" ]; then ok "engine venv"; else warn "engine venv" "run ./formencoder install"; fi
vpy="$FORMENCODER_ROOT/backend/venv/bin/python"
if [ -x "$vpy" ]; then
  if "$vpy" -c "import fe_core" >/dev/null 2>&1; then
    ok "encoding engine $("$vpy" -c 'import fe_core; print(fe_core.__version__)')"
    info="$("$vpy" -c 'import json, fe_core; i = json.loads(fe_core.ffmpeg_info()); v = i["version"]; print(("ok " + v.get("version", "") + " " + v.get("licence", "") + " (" + i["origin"] + ") " + i["ffmpeg"]) if v.get("found") else "missing")')"
    case "$info" in
      ok*) ok "ffmpeg ${info#ok }" ;;
      *) warn "ffmpeg" "not found; formencoder downloads its LGPL build on first start, or set FORMENCODER_FFMPEG_DIR" ;;
    esac
  else bad "encoding engine" "run ./formencoder install-native"; fi
fi
if [ -d "$FORMENCODER_ROOT/frontend/node_modules" ]; then ok "interface node_modules"; else warn "interface deps" "run ./formencoder install"; fi
for a in claude codex cursor-agent; do
  if command -v "$a" >/dev/null 2>&1; then ok "agent $a"; else warn "agent $a" "not on PATH (optional)"; fi
done
for port in 5270 "${FORMENCODER_PORT:-8270}"; do
  if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then warn "port $port" "already in use"; else ok "port $port free"; fi
done
if [ "$fail" = 0 ]; then fe_say "ready"; else fe_say "fix the FAIL lines above"; fi
exit "$fail"
